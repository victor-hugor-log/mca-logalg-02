programa {

  funcao inicio() {

    inteiro qtd

    real preco, custo, venda, lucro

    escreva("Quantidade de capinhas: ")

    leia(qtd)

    escreva("Preço de venda unitário: R$ ")

    leia(preco)

    custo = qtd * 5.80

    venda = qtd * preco

    lucro = venda - custo

    escreva("Custo total: R$ ", custo, "\n")

    escreva("Lucro líquido: R$ ", lucro)

  }

}