programa {

  funcao inicio() {

    real largura, altura, area, litros

    escreva("Largura da parede: ")

    leia(largura)

    escreva("Altura da parede: ")

    leia(altura)

    area = largura * altura

    litros = area / 3

    escreva("Área: ", area, " m2\n")

    escreva("Tinta necessária: ", litros, " litros")

  }

}