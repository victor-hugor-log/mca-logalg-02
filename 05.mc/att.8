programa {

  funcao inicio() {

    inteiro m10, m25, m50

    real total

    escreva("Moedas de 10 centavos: ")

    leia(m10)

    escreva("Moedas de 25 centavos: ")

    leia(m25)

    escreva("Moedas de 50 centavos: ")

    leia(m50)

    total = m10 * 0.10 + m25 * 0.25 + m50 * 0.50

    escreva("Total poupado: R$ ", total)

  }

}