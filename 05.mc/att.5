programa {

  funcao inicio() {

    inteiro total, horas, minutos, segundos

    escreva("Tempo total em segundos: ")

    leia(total)

    horas = total / 3600

    minutos = (total % 3600) / 60

    segundos = total % 60

    escreva(horas, " horas, ", minutos, " minutos e ", segundos, " segundos")

  }

}